        <Viewbox Stretch="Fill">
            <Canvas Width="130" Height="91">
                <Rectangle Width="130" Height="91" Fill="#FFFFFF" />
                <Rectangle Width="130" Height="7" Fill="#B22234" Canvas.Top="0" />
                <Rectangle Width="130" Height="7" Fill="#B22234" Canvas.Top="14" />
                <Rectangle Width="130" Height="7" Fill="#B22234" Canvas.Top="28" />
                <Rectangle Width="130" Height="7" Fill="#B22234" Canvas.Top="42" />
                <Rectangle Width="130" Height="7" Fill="#B22234" Canvas.Top="56" />
                <Rectangle Width="130" Height="7" Fill="#B22234" Canvas.Top="70" />
                <Rectangle Width="130" Height="7" Fill="#B22234" Canvas.Top="84" />
                <Rectangle Width="52" Height="49" Fill="#3C3B6E" />
                <!-- estrelas simplificadas: grade de pontos brancos -->
                <Path Fill="White" Data="M7,7 h4 v4 h-4 z M19,7 h4 v4 h-4 z M31,7 h4 v4 h-4 z M43,7 h4 v4 h-4 z
                                         M13,15 h4 v4 h-4 z M25,15 h4 v4 h-4 z M37,15 h4 v4 h-4 z
                                         M7,23 h4 v4 h-4 z M19,23 h4 v4 h-4 z M31,23 h4 v4 h-4 z M43,23 h4 v4 h-4 z
                                         M13,31 h4 v4 h-4 z M25,31 h4 v4 h-4 z M37,31 h4 v4 h-4 z
                                         M7,39 h4 v4 h-4 z M19,39 h4 v4 h-4 z M31,39 h4 v4 h-4 z M43,39 h4 v4 h-4 z" />
            </Canvas>
        </Viewbox>
    </Border>
</UserControl>

