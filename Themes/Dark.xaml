<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema escuro: branco sobre preto. As mesmas chaves existem em Light.xaml. -->
    <Color x:Key="AppBgColor">#000000</Color>
    <Color x:Key="AccentColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="AppBg" Color="#000000" />
    <SolidColorBrush x:Key="SidebarBg" Color="#000000" />
    <SolidColorBrush x:Key="CardBg" Color="#000000" />
    <SolidColorBrush x:Key="CardRaised" Color="#121212" />
    <SolidColorBrush x:Key="Hover" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Pressed" Color="#2C2C2C" />
    <SolidColorBrush x:Key="BorderSoft" Color="#2E2E2E" />
    <SolidColorBrush x:Key="BorderStrong" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#C4C4C4" />
    <SolidColorBrush x:Key="TextTertiary" Color="#8C8C8C" />
    <SolidColorBrush x:Key="Accent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#D6D6D6" />
    <SolidColorBrush x:Key="AccentPressed" Color="#B8B8B8" />
    <SolidColorBrush x:Key="AccentSoft" Color="#222222" />
    <SolidColorBrush x:Key="OnAccent" Color="#000000" />
    <SolidColorBrush x:Key="Track" Color="#262626" />
    <SolidColorBrush x:Key="ChartGrid" Color="#242424" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#555555" />
    <SolidColorBrush x:Key="SwitchTrackOff" Color="#444444" />
    <SolidColorBrush x:Key="SwitchThumbOff" Color="#C4C4C4" />

    <!-- Cores de estado: só aparecem onde carregam significado (ok, atenção, erro). -->
    <SolidColorBrush x:Key="Success" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#0F2A18" />
    <SolidColorBrush x:Key="Warning" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningSoft" Color="#33270A" />
    <SolidColorBrush x:Key="Danger" Color="#F87171" />
    <SolidColorBrush x:Key="DangerSoft" Color="#3A1414" />

    <!-- Séries dos gráficos: tons de cinza (a temperatura mantém o laranja para destacar). -->
    <SolidColorBrush x:Key="Teal" Color="#A3A3A3" />
    <SolidColorBrush x:Key="Violet" Color="#6E6E6E" />
    <SolidColorBrush x:Key="Orange" Color="#FB923C" />

    <SolidColorBrush x:Key="HeroBrush" Color="#161616" />

    <DropShadowEffect x:Key="CardShadow" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#000000" />
</ResourceDictionary>
