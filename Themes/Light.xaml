<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema claro: preto sobre branco. As mesmas chaves existem em Dark.xaml. -->
    <Color x:Key="AppBgColor">#FFFFFF</Color>
    <Color x:Key="AccentColor">#000000</Color>

    <SolidColorBrush x:Key="AppBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardRaised" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Hover" Color="#EBEBEB" />
    <SolidColorBrush x:Key="Pressed" Color="#D9D9D9" />
    <SolidColorBrush x:Key="BorderSoft" Color="#D0D0D0" />
    <SolidColorBrush x:Key="BorderStrong" Color="#000000" />
    <SolidColorBrush x:Key="TextPrimary" Color="#000000" />
    <SolidColorBrush x:Key="TextSecondary" Color="#3D3D3D" />
    <SolidColorBrush x:Key="TextTertiary" Color="#6B6B6B" />
    <SolidColorBrush x:Key="Accent" Color="#000000" />
    <SolidColorBrush x:Key="AccentHover" Color="#2E2E2E" />
    <SolidColorBrush x:Key="AccentPressed" Color="#4A4A4A" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EBEBEB" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Track" Color="#E4E4E4" />
    <SolidColorBrush x:Key="ChartGrid" Color="#E4E4E4" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#9C9C9C" />
    <SolidColorBrush x:Key="SwitchTrackOff" Color="#BDBDBD" />
    <SolidColorBrush x:Key="SwitchThumbOff" Color="#FFFFFF" />

    <!-- Cores de estado: só aparecem onde carregam significado (ok, atenção, erro). -->
    <SolidColorBrush x:Key="Success" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#DDF3E4" />
    <SolidColorBrush x:Key="Warning" Color="#B45309" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FDEFD0" />
    <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FBDADA" />

    <!-- Séries dos gráficos: tons de cinza (a temperatura mantém o laranja para destacar). -->
    <SolidColorBrush x:Key="Teal" Color="#6B6B6B" />
    <SolidColorBrush x:Key="Violet" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Orange" Color="#D97706" />

    <SolidColorBrush x:Key="HeroBrush" Color="#000000" />

    <DropShadowEffect x:Key="CardShadow" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#000000" />
</ResourceDictionary>
