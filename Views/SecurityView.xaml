<UserControl x:Class="Otimizador.App.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Otimizador.App"
             xmlns:ctl="clr-namespace:Otimizador.App.Controls"
             xmlns:vm="clr-namespace:Otimizador.App.ViewModels"
             Style="{StaticResource PageRoot}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,28">

            <Border Style="{StaticResource Card}" Margin="6" Padding="22,18">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource NotBool}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                            <TextBlock Text="{app:Tr Sec_Run}" Margin="9,0,0,0" />
                        </StackPanel>
                    </Button>
                    <ctl:RingGauge DockPanel.Dock="Left" Width="104" Height="104" Margin="0,0,22,0" Value="{Binding ScorePercent}" Text="{Binding ScoreText}"
                                   SubText="OK" TrackBrush="{DynamicResource Track}" ValueBrush="{DynamicResource Success}"
                                   TextBrush="{DynamicResource TextPrimary}" SubTextBrush="{DynamicResource TextTertiary}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{app:Tr Sec_Title}" Style="{StaticResource TitleMd}" />
                        <TextBlock Text="{app:Tr Sec_Sub}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,8,0,0"
                                   Visibility="{Binding Status, Converter={StaticResource S2V}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="6" Padding="20,6,20,12" Visibility="{Binding HasResult, Converter={StaticResource B2V}}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SecurityRow}">
                            <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="0,13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ContentControl x:Name="Badge" Grid.Column="1" Style="{StaticResource Chip}" Content="{Binding LevelText}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="0">
                                    <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource Success}" />
                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SuccessSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="1">
                                    <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource Warning}" />
                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource WarningSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="2">
                                    <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource Danger}" />
                                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerSoft}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
