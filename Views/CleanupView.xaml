<UserControl x:Class="Otimizador.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Otimizador.App"
             Style="{StaticResource PageRoot}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,28" IsEnabled="{Binding IsIdle}">

            <!-- Temporários e caches -->
            <Border Style="{StaticResource Card}" Margin="6" Padding="20,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding MeasureCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="{app:Tr Clean_Rescan}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CleanCommand}" Style="{StaticResource PrimaryButton}" Padding="22,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                                    <TextBlock Text="{app:Tr Clean_Button}" Margin="9,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{app:Tr Clean_Title}" Style="{StaticResource TitleMd}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{app:Tr Clean_WillFree}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalText}" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <Border Margin="0,6,0,6" Padding="14,10" Background="{DynamicResource CardRaised}"
                            Visibility="{Binding Status, Converter={StaticResource S2V}}">
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="0,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource SelectCheck}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <ContentControl Grid.Column="2" Style="{StaticResource ChipAccent}" Content="{app:Tr Opt_Admin}"
                                                        VerticalAlignment="Center" Margin="10,0"
                                                        Visibility="{Binding NeedsAdmin, Converter={StaticResource B2V}}" />
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="14"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Aplicativos pré-instalados -->
            <Border Style="{StaticResource Card}" Margin="6" Padding="20,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Command="{Binding RemoveAppsCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                                <TextBlock Text="{app:Tr Apps_Remove}" Margin="9,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{app:Tr Apps_Title}" Style="{StaticResource TitleMd}" />
                            <TextBlock Text="{app:Tr Apps_Sub}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{app:Tr Apps_Loading}" Style="{StaticResource Body}"
                               Visibility="{Binding AppsLoading, Converter={StaticResource B2V}}" />
                    <TextBlock Text="{Binding AppsStatus}" Style="{StaticResource Body}" Margin="0,4,0,8"
                               Visibility="{Binding AppsStatus, Converter={StaticResource S2V}}" />
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,6,28,6" MinWidth="280">
                                    <CheckBox Style="{StaticResource SelectCheck}" IsChecked="{Binding IsSelected}" />
                                    <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
