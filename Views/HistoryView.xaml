<UserControl x:Class="Otimizador.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Otimizador.App"
             xmlns:ctl="clr-namespace:Otimizador.App.Controls"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,28">

            <DockPanel Margin="6,0,6,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                            <TextBlock Text="{app:Tr Hw_Refresh}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportReportCommand}" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" />
                            <TextBlock Text="{app:Tr Hist_Report}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ListBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" Style="{StaticResource Segmented}"
                         HorizontalAlignment="Left">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title.Text}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <TextBlock Text="{Binding ReportStatus}" Style="{StaticResource Caption}" Margin="8,0,6,8"
                       Visibility="{Binding ReportStatus, Converter={StaticResource S2V}}" />

            <Border Style="{StaticResource Card}" Margin="6" Padding="22,18" Visibility="{Binding HasData, Converter={StaticResource IBV}}">
                <TextBlock Text="{app:Tr Hist_NoData}" Style="{StaticResource Body}" />
            </Border>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource B2V}}">
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="{app:Tr Hist_MaxCpu}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding MaxCpuTemp}" Style="{StaticResource Metric}" FontSize="22" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="{app:Tr Hist_MaxGpu}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding MaxGpuTemp}" Style="{StaticResource Metric}" FontSize="22" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="{app:Tr Hist_AvgCpu}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding AvgCpuLoad}" Style="{StaticResource Metric}" FontSize="22" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="{app:Tr Hist_AvgRam}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding AvgRam}" Style="{StaticResource Metric}" FontSize="22" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Rectangle Width="9" Height="9" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="{app:Tr Hist_Usage}" Style="{StaticResource Caption}" Margin="6,0,14,0" />
                                <Rectangle Width="9" Height="9" Fill="{DynamicResource Orange}" VerticalAlignment="Center" />
                                <TextBlock Text="{app:Tr Hist_TempMax}" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="CPU" Style="{StaticResource TitleMd}" />
                        </DockPanel>
                        <Grid Height="160" Margin="0,10,0,0">
                            <ctl:Sparkline Values="{Binding CpuLoad}" Capacity="{Binding Capacity}" Stroke="{DynamicResource Accent}"
                                           ShowGrid="True" ShowLabels="True" Unit="" GridBrush="{DynamicResource ChartGrid}"
                                           LabelBrush="{DynamicResource TextTertiary}" Thickness="1.5" />
                            <ctl:Sparkline Values="{Binding CpuTemp}" Capacity="{Binding Capacity}" Stroke="{DynamicResource Orange}"
                                           FillArea="False" ShowLabels="True" Thickness="1.5" />
                        </Grid>
                        <TextBlock Text="{Binding RangeStart}" Style="{StaticResource Caption}" Margin="38,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Rectangle Width="9" Height="9" Fill="{DynamicResource Teal}" VerticalAlignment="Center" />
                                <TextBlock Text="{app:Tr Hist_Usage}" Style="{StaticResource Caption}" Margin="6,0,14,0" />
                                <Rectangle Width="9" Height="9" Fill="{DynamicResource Orange}" VerticalAlignment="Center" />
                                <TextBlock Text="{app:Tr Hist_TempMax}" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="GPU" Style="{StaticResource TitleMd}" />
                        </DockPanel>
                        <Grid Height="160" Margin="0,10,0,0">
                            <ctl:Sparkline Values="{Binding GpuLoad}" Capacity="{Binding Capacity}" Stroke="{DynamicResource Teal}"
                                           ShowGrid="True" ShowLabels="True" GridBrush="{DynamicResource ChartGrid}"
                                           LabelBrush="{DynamicResource TextTertiary}" Thickness="1.5" />
                            <ctl:Sparkline Values="{Binding GpuTemp}" Capacity="{Binding Capacity}" Stroke="{DynamicResource Orange}"
                                           FillArea="False" ShowLabels="True" Thickness="1.5" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <TextBlock Text="{app:Tr Mon_Ram}" Style="{StaticResource TitleMd}" />
                        <Grid Height="140" Margin="0,10,0,0">
                            <ctl:Sparkline Values="{Binding Ram}" Capacity="{Binding Capacity}" Stroke="{DynamicResource Violet}"
                                           ShowGrid="True" ShowLabels="True" GridBrush="{DynamicResource ChartGrid}"
                                           LabelBrush="{DynamicResource TextTertiary}" Thickness="1.5" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="6" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="{app:Tr Hist_Events}" Style="{StaticResource TitleMd}" />
                    <TextBlock Text="{app:Tr Hist_EventsSub}" Style="{StaticResource Caption}" Margin="0,2,0,8" />
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <ContentControl Grid.Column="1" Style="{StaticResource Chip}" Content="{Binding Kind}" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

