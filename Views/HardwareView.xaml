<UserControl x:Class="Otimizador.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Otimizador.App"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="SummaryTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <DataTemplate x:Key="SectionTemplate">
            <Border Style="{StaticResource Card}" Margin="6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="32" Height="32" CornerRadius="0" Background="{DynamicResource AccentSoft}">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14"
                                       Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource TitleMd}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,28">

            <DockPanel Margin="6,0,6,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                            <TextBlock Text="{app:Tr Hw_Refresh}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" />
                            <TextBlock Text="{app:Tr Hw_Export}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Resumo -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource SummaryTile}">
                    <StackPanel>
                        <TextBlock Text="{app:Tr Sec_Cpu}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding CpuName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryTile}">
                    <StackPanel>
                        <TextBlock Text="{app:Tr Sec_Gpu}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding GpuName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryTile}">
                    <StackPanel>
                        <TextBlock Text="{app:Tr Sec_Memory}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding RamTotal}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SummaryTile}">
                    <StackPanel>
                        <TextBlock Text="{app:Tr Sec_System}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding OsName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Saúde dos discos -->
            <Border Style="{StaticResource Card}" Margin="6,6,6,6" Padding="20,16" Visibility="{Binding HasDisks, Converter={StaticResource B2V}}">
                <StackPanel>
                    <TextBlock Text="{app:Tr Health_Title}" Style="{StaticResource TitleMd}" />
                    <TextBlock Text="{app:Tr Health_Sub}" Style="{StaticResource Caption}" Margin="0,2,0,8" />
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <TextBlock Margin="0,0,22,0"><Run Text="{app:Tr Health_Temp}" Foreground="{DynamicResource TextTertiary}" /><Run Text=" " /><Run Text="{Binding Temperature, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                                <TextBlock Margin="0,0,22,0"><Run Text="{app:Tr Health_Wear}" Foreground="{DynamicResource TextTertiary}" /><Run Text=" " /><Run Text="{Binding Wear, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                                <TextBlock Margin="0,0,22,0"><Run Text="{app:Tr Health_Hours}" Foreground="{DynamicResource TextTertiary}" /><Run Text=" " /><Run Text="{Binding Hours, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                                <TextBlock><Run Text="{app:Tr Health_Errors}" Foreground="{DynamicResource TextTertiary}" /><Run Text=" " /><Run Text="{Binding Errors, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                                       Visibility="{Binding HasDetails, Converter={StaticResource B2V}}" />
                                        </StackPanel>
                                        <ContentControl x:Name="Verdict" Grid.Column="1" Style="{StaticResource ChipSuccess}" Content="{Binding Verdict}"
                                                        VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="1">
                                        <Setter TargetName="Verdict" Property="Foreground" Value="{DynamicResource Warning}" />
                                        <Setter TargetName="Verdict" Property="Background" Value="{DynamicResource WarningSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="2">
                                        <Setter TargetName="Verdict" Property="Foreground" Value="{DynamicResource Danger}" />
                                        <Setter TargetName="Verdict" Property="Background" Value="{DynamicResource DangerSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="3">
                                        <Setter TargetName="Verdict" Property="Foreground" Value="{DynamicResource TextTertiary}" />
                                        <Setter TargetName="Verdict" Property="Background" Value="{DynamicResource Track}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- Saúde da bateria (notebooks) -->
            <Border Style="{StaticResource Card}" Margin="6" Padding="20,16" Visibility="{Binding HasBattery, Converter={StaticResource B2V}}" DataContext="{Binding Battery}">
                <StackPanel>
                    <DockPanel>
                        <ContentControl x:Name="BatVerdict" DockPanel.Dock="Right" Style="{StaticResource ChipSuccess}" Content="{Binding Verdict}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{app:Tr Bat_Title}" Style="{StaticResource TitleMd}" />
                            <TextBlock Text="{app:Tr Bat_Sub}" Style="{StaticResource Caption}" Margin="0,2,0,8" />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel>
                        <TextBlock Margin="0,0,24,0"><Run Text="{app:Tr Bat_Health}" Foreground="{DynamicResource TextTertiary}" /><Run Text=" " /><Run Text="{Binding Health, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" /></TextBlock>
                        <TextBlock Margin="0,0,24,0"><Run Text="{app:Tr Bat_Design}" Foreground="{DynamicResource TextTertiary}" /><Run Text=" " /><Run Text="{Binding Design, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock Margin="0,0,24,0"><Run Text="{app:Tr Bat_Full}" Foreground="{DynamicResource TextTertiary}" /><Run Text=" " /><Run Text="{Binding Full, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock Margin="0,0,24,0"><Run Text="{app:Tr Bat_Cycles}" Foreground="{DynamicResource TextTertiary}" /><Run Text=" " /><Run Text="{Binding Cycles, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        <TextBlock><Run Text="{app:Tr Bat_Charge}" Foreground="{DynamicResource TextTertiary}" /><Run Text=" " /><Run Text="{Binding Charge, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <!-- Seções: duas colunas independentes -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding LeftSections}" ItemTemplate="{StaticResource SectionTemplate}" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding RightSections}" ItemTemplate="{StaticResource SectionTemplate}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>



