<UserControl x:Class="Otimizador.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Otimizador.App"
             Style="{StaticResource PageRoot}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,28">

            <Border Style="{StaticResource Card}" Margin="6,0,6,6" Padding="20,16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding ReloadCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                            <TextBlock Text="{app:Tr Hw_Refresh}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource TitleMd}" />
                        <TextBlock Text="{app:Tr Boot_Hint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Margin="6,0,6,6" Padding="16,12" Background="{DynamicResource CardRaised}" Visibility="{Binding Status, Converter={StaticResource S2V}}">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="6" Padding="20,6,20,12">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Body}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" Visibility="{Binding HasSubtitle, Converter={StaticResource B2V}}" />
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ContentControl Grid.Column="1" Style="{StaticResource Chip}" Content="{Binding Source}"
                                                    VerticalAlignment="Center" Margin="12,0" />
                                    <CheckBox Grid.Column="2" Style="{StaticResource SwitchCheck}" IsChecked="{Binding IsEnabled}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
