<UserControl x:Class="Otimizador.App.Views.TestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Otimizador.App"
             xmlns:ctl="clr-namespace:Otimizador.App.Controls"
             xmlns:vm="clr-namespace:Otimizador.App.ViewModels"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource CardFlat}">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <DataTemplate x:Key="ScoreTileTemplate" DataType="{x:Type vm:ScoreTile}">
            <Border Style="{StaticResource CardFlat}" Margin="0,0,10,10" Padding="16,12" Width="168">
                <StackPanel>
                    <TextBlock Text="{Binding Title.Text}" Style="{StaticResource Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Unit}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="5,0,0,4" />
                    </StackPanel>
                    <DockPanel Margin="0,6,0,0">
                        <ContentControl x:Name="Delta" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="{Binding DeltaText}"
                                        Visibility="{Binding DeltaText, Converter={StaticResource S2V}}" />
                        <TextBlock Text="{Binding PreviousText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DeltaKind}" Value="1">
                    <Setter TargetName="Delta" Property="Foreground" Value="{DynamicResource Success}" />
                    <Setter TargetName="Delta" Property="Background" Value="{DynamicResource SuccessSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeltaKind}" Value="-1">
                    <Setter TargetName="Delta" Property="Foreground" Value="{DynamicResource Danger}" />
                    <Setter TargetName="Delta" Property="Background" Value="{DynamicResource DangerSoft}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,14,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Teste rápido -->
            <Border Style="{StaticResource Card}" Margin="6" Padding="22">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="0" Background="{DynamicResource AccentSoft}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="18" Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" />
                        </Border><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{app:Tr Test_Quick}" Style="{StaticResource TitleMd}" /><TextBlock Text="{app:Tr Test_QuickSub}" Style="{StaticResource Caption}" /></StackPanel></Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Command="{Binding QuickTestCommand}" Style="{StaticResource PrimaryButton}" Padding="22,10"
                                Visibility="{Binding QuickRunning, Converter={StaticResource IBV}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" />
                                <TextBlock Text="{app:Tr Test_StartQuick}" Margin="9,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelCommand}" Padding="22,10"
                                Visibility="{Binding QuickRunning, Converter={StaticResource B2V}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" />
                                <TextBlock Text="{app:Tr Test_Cancel}" Margin="9,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ProgressBar Value="{Binding QuickProgress, Mode=OneWay}" Margin="0,18,0,6" />
                    <TextBlock Text="{Binding QuickStatus}" Style="{StaticResource Caption}" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource ScoreTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Estabilidade -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6" Padding="22">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="40" Height="40" CornerRadius="0" Background="{DynamicResource SuccessSoft}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9F5;" FontSize="18" Foreground="{DynamicResource Success}"
                                       HorizontalAlignment="Center" />
                        </Border><StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{app:Tr Test_Stress}" Style="{StaticResource TitleMd}" /><TextBlock Text="{app:Tr Test_StressSub}" Style="{StaticResource Caption}" /></StackPanel></Grid>

                    <WrapPanel Margin="0,18,0,0">
                        <ListBox ItemsSource="{Binding Durations}" SelectedItem="{Binding SelectedDuration}"
                                 Style="{StaticResource Segmented}" IsEnabled="{Binding IsIdle}" Margin="0,0,14,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Command="{Binding StressCommand}" Style="{StaticResource PrimaryButton}" Padding="22,10"
                                Visibility="{Binding StressRunning, Converter={StaticResource IBV}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" />
                                <TextBlock Text="{app:Tr Test_StartStress}" Margin="9,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelCommand}" Padding="22,10"
                                Visibility="{Binding StressRunning, Converter={StaticResource B2V}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" />
                                <TextBlock Text="{app:Tr Test_Cancel}" Margin="9,0,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <ProgressBar Value="{Binding StressProgress, Mode=OneWay}" Margin="0,18,0,14" />

                    <UniformGrid Columns="4" Margin="0,0,-8,0">
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <TextBlock Text="{app:Tr Test_Elapsed}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ElapsedText}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <TextBlock Text="{app:Tr Test_Errors}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding ErrorsText}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <TextBlock Text="{app:Tr Test_Temp}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding TempText}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <TextBlock Text="{app:Tr Test_MaxTemp}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding MaxTempText}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Height="150" Margin="0,16,0,0">
                        <ctl:Sparkline Values="{Binding LoadChart}" Stroke="{DynamicResource Accent}" ShowGrid="True"
                                       GridBrush="{DynamicResource ChartGrid}" Capacity="120" />
                        <ctl:Sparkline Values="{Binding TempChart}" Stroke="{DynamicResource Orange}" FillArea="False" Capacity="120" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Rectangle Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="{app:Tr Test_Load}" Style="{StaticResource Caption}" Margin="6,0,16,0" />
                        <Rectangle Width="8" Height="8" Fill="{DynamicResource Orange}" VerticalAlignment="Center" />
                        <TextBlock Text="{app:Tr Test_Temp}" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                    </StackPanel>

                    <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="0" Visibility="{Binding ResultText, Converter={StaticResource S2V}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource CardRaised}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultKind}" Value="1">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultKind}" Value="2">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ResultKind}" Value="3">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>



