<UserControl x:Class="Otimizador.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Otimizador.App"
             xmlns:vm="clr-namespace:Otimizador.App.ViewModels"
             Style="{StaticResource PageRoot}">
    <Grid IsEnabled="{Binding IsIdle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Perfis e limpeza -->
        <Grid Margin="0,0,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="6">
                <StackPanel>
                    <TextBlock Text="{app:Tr Opt_Profiles}" Style="{StaticResource TitleMd}" />
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                             Style="{StaticResource Segmented}" HorizontalAlignment="Left" Margin="0,12,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title.Text}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding SelectedProfile.Description.Text}" Style="{StaticResource Body}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6">
                <StackPanel>
                    <TextBlock Text="{app:Tr Nav_Cleanup}" Style="{StaticResource TitleMd}" />
                    <TextBlock Text="{app:Tr Opt_CleanupSub}" Style="{StaticResource Body}" Margin="0,6,0,12" />
                    <Button Command="{Binding OpenCleanupCommand}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                            <TextBlock Text="{app:Tr Opt_OpenCleanup}" Margin="9,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Ajustes -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,14,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TweakItem}">
                        <Border x:Name="Row" Style="{StaticResource Card}" Margin="6,4" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="42" Height="42" CornerRadius="0" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="17"
                                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,14,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TitleSm}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,3,0,8" />
                                    <WrapPanel>
                                        <ContentControl Style="{StaticResource ChipSuccess}" Margin="0,0,6,0" Content="{app:Tr Opt_Active}"
                                                        Visibility="{Binding IsApplied, Converter={StaticResource B2V}}" />
                                        <ContentControl x:Name="RiskChip" Style="{StaticResource Chip}" Margin="0,0,6,0" Content="{Binding RiskText}" />
                                        <ContentControl Style="{StaticResource ChipAccent}" Margin="0,0,6,0" Content="{app:Tr Opt_Admin}"
                                                        Visibility="{Binding Tweak.NeedsAdmin, Converter={StaticResource B2V}}" />
                                        <ContentControl Style="{StaticResource ChipWarning}" Margin="0,0,6,0" Content="{app:Tr Opt_Reboot}"
                                                        Visibility="{Binding Tweak.NeedsReboot, Converter={StaticResource B2V}}" />
                                    </WrapPanel>
                                </StackPanel>

                                <CheckBox Grid.Column="2" Style="{StaticResource SelectCheck}" IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMedium}" Value="True">
                                <Setter TargetName="RiskChip" Property="Foreground" Value="{DynamicResource Warning}" />
                                <Setter TargetName="RiskChip" Property="Background" Value="{DynamicResource WarningSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Resultado -->
        <Border Grid.Row="2" Margin="6,6,20,0" Padding="16,12" CornerRadius="0"
                Visibility="{Binding Status, Converter={StaticResource S2V}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource CardRaised}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusKind}" Value="1">
                            <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusKind}" Value="2">
                            <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </Border>

        <!-- Barra de ações -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="6,10,20,22" Padding="18,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding ClearSelectionCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
                        <TextBlock Text="{app:Tr Opt_Clear}" />
                    </Button>
                    <Button Command="{Binding RevertCommand}" Margin="0,0,8,0">
                        <TextBlock Text="{app:Tr Opt_Revert}" />
                    </Button>
                    <Button Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Padding="22,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" />
                            <TextBlock Text="{app:Tr Opt_Apply}" Margin="9,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="{app:Tr Opt_Selected}" Style="{StaticResource Body}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>


