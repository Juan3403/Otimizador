<UserControl x:Class="Otimizador.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Otimizador.App"
             xmlns:vm="clr-namespace:Otimizador.App.ViewModels"
             Style="{StaticResource PageRoot}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,28">

            <Border Style="{StaticResource Card}" Margin="6" Padding="20,16">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheck}" IsChecked="{Binding Enabled}"
                                  IsEnabled="{Binding HasFolder}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="{app:Tr Inv_Title}" Style="{StaticResource TitleMd}" />
                            <TextBlock Text="{app:Tr Inv_Sub}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding ChooseFolderCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="13" />
                                <TextBlock Text="{app:Tr Inv_Choose}" Margin="9,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBox Text="{Binding Folder, Mode=OneWay}" IsReadOnly="True" />
                    </DockPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Command="{Binding PublishCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" IsEnabled="{Binding HasFolder}">
                            <TextBlock Text="{app:Tr Inv_Publish}" />
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Margin="0,0,8,0">
                            <TextBlock Text="{app:Tr Hw_Refresh}" />
                        </Button>
                        <Button Command="{Binding ExportCsvCommand}">
                            <TextBlock Text="{app:Tr Inv_Csv}" />
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Visibility="{Binding Status, Converter={StaticResource S2V}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Margin="10,6,6,8" />

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:InventoryRow}">
                        <Border Style="{StaticResource Card}" Margin="6,4" Padding="18,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Machine}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding User}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Specs}" Style="{StaticResource Body}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding Os}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Disks}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <ContentControl x:Name="Badge" Style="{StaticResource Chip}" Content="{Binding LevelText}" HorizontalAlignment="Right" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" HorizontalAlignment="Right">
                                        <Run Text="{app:Tr Nav_Security}" /><Run Text=" " /><Run Text="{Binding Security, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding LastSeen}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="0">
                                <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource Success}" />
                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource SuccessSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="1">
                                <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource Warning}" />
                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource WarningSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="2">
                                <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource Danger}" />
                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource DangerSoft}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
