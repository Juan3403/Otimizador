<UserControl x:Class="Otimizador.App.Views.SpaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Otimizador.App"
             xmlns:ctl="clr-namespace:Otimizador.App.Controls"
             xmlns:vm="clr-namespace:Otimizador.App.ViewModels"
             Style="{StaticResource PageRoot}">
    <UserControl.Resources>
        <!-- Linha das listas de arquivos e pastas -->
        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type vm:SpaceEntry}">
            <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Padding="0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Style="{StaticResource SelectCheck}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                              Visibility="{Binding CanSelect, Converter={StaticResource B2V}}" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="14" Foreground="{DynamicResource TextTertiary}"
                               ToolTip="{app:Tr Space_Protected}" HorizontalAlignment="Center"
                               Visibility="{Binding IsProtected, Converter={StaticResource B2V}}" />

                    <Rectangle Grid.Column="1" Width="10" Height="10" Fill="{Binding Brush}" Margin="4,0,12,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Folder}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                    </StackPanel>

                    <ProgressBar Grid.Column="3" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="14,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE8A7;" Margin="6,0,0,0"
                            ToolTip="{app:Tr Space_Open}"
                            Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,14,28">

            <!-- Disco e análise -->
            <Border Style="{StaticResource Card}" Margin="6,0,6,6" Padding="20,16">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsScanning, Converter={StaticResource B2V}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" />
                                    <TextBlock Text="{app:Tr Test_Cancel}" Margin="9,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Padding="22,10"
                                    Visibility="{Binding IsScanning, Converter={StaticResource IBV}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" />
                                    <TextBlock Text="{app:Tr Space_Analyze}" Margin="9,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{app:Tr Space_Drive}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ListBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                                     Style="{StaticResource Segmented}" IsEnabled="{Binding IsIdle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Display}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Detail}" FontSize="10.5" Opacity="0.8" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsScanning, Converter={StaticResource B2V}}">
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScanText}" FontWeight="SemiBold" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Estado inicial -->
            <Border Style="{StaticResource Card}" Margin="6" Padding="28,26"
                    Visibility="{Binding HasResult, Converter={StaticResource IBV}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="0" Background="{DynamicResource AccentSoft}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="20" Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{app:Tr Space_IntroTitle}" Style="{StaticResource TitleMd}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{app:Tr Space_Intro}" Style="{StaticResource Body}" Margin="0,14,0,0" FontSize="13.5" />
                    <TextBlock Text="{app:Tr Space_IntroSafe}" Style="{StaticResource Body}" Margin="0,10,0,0" FontSize="13.5" />
                </StackPanel>
            </Border>

            <!-- Resultado -->
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource B2V}}">

                <WrapPanel Margin="6,8,6,6">
                    <ContentControl Style="{StaticResource ChipAccent}" Margin="0,0,8,6">
                        <TextBlock><Run Text="{app:Tr Space_Total}" /><Run Text=": " /><Run Text="{Binding DriveTotalText, Mode=OneWay}" /></TextBlock>
                    </ContentControl>
                    <ContentControl Style="{StaticResource Chip}" Margin="0,0,8,6">
                        <TextBlock><Run Text="{app:Tr Space_Used}" /><Run Text=": " /><Run Text="{Binding DriveUsedText, Mode=OneWay}" /></TextBlock>
                    </ContentControl>
                    <ContentControl Style="{StaticResource ChipSuccess}" Margin="0,0,8,6">
                        <TextBlock><Run Text="{app:Tr Space_Free}" /><Run Text=": " /><Run Text="{Binding DriveFreeText, Mode=OneWay}" /></TextBlock>
                    </ContentControl>
                    <ContentControl Style="{StaticResource ChipWarning}" Margin="0,0,8,6" Content="{app:Tr Space_Partial}"
                                    Visibility="{Binding PartialScan, Converter={StaticResource B2V}}" />
                </WrapPanel>

                <Border Margin="6,0,6,6" Padding="16,12" CornerRadius="0" Visibility="{Binding Status, Converter={StaticResource S2V}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardRaised}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="2">
                                    <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                </Border>

                <!-- Mapa -->
                <Border Style="{StaticResource Card}" Margin="6" Padding="18,14,18,16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" Margin="0,0,10,0"
                                    ToolTip="{app:Tr Space_Up}" Command="{Binding UpCommand}" IsEnabled="{Binding CanGoUp}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ViewRoot.FullPath}" Style="{StaticResource TitleSm}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                                <TextBlock Text="{app:Tr Space_MapHint}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>

                        <Border CornerRadius="0" ClipToBounds="True" Height="430" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                            <ctl:TreemapView RootNode="{Binding ViewRoot}" Version="{Binding TreemapVersion}"
                                             BackdropBrush="{DynamicResource CardRaised}" FolderBrush="{DynamicResource CardBg}"
                                             FolderBorderBrush="{DynamicResource BorderStrong}" TextBrush="{DynamicResource TextPrimary}"
                                             HoverText="{Binding HoverText, Mode=OneWayToSource}"
                                             ActivateCommand="{Binding ZoomCommand}" SelectCommand="{Binding SelectNodeCommand}"
                                             UpCommand="{Binding UpCommand}" />
                        </Border>
                        <TextBlock Text="{Binding HoverText}" Style="{StaticResource Caption}" Margin="2,8,0,0" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" MinHeight="16" />

                        <ItemsControl ItemsSource="{Binding Categories}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
                                        <Border Width="12" Height="12" CornerRadius="0" Background="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title.Text}" Margin="7,0,0,0" FontWeight="SemiBold" />
                                        <TextBlock Margin="6,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center">
                                            <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Percent, Mode=OneWay, StringFormat={}{0:0.#}%}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Listas e ação de apagar -->
                <Border Style="{StaticResource Card}" Margin="6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <ListBox DockPanel.Dock="Right" ItemsSource="{Binding ListModes}" SelectedItem="{Binding SelectedMode}"
                                     Style="{StaticResource Segmented}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title.Text}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{app:Tr Space_ListTitle}" Style="{StaticResource TitleMd}" />
                                <TextBlock Text="{app:Tr Space_ListHint}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource CardFlat}" Padding="14,10" Margin="0,0,0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding OpenInstalledAppsCommand}" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{app:Tr Space_OpenApps}" />
                                </Button>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Style="{StaticResource SwitchCheck}" IsChecked="{Binding ShowProtected}" />
                                        <TextBlock Text="{app:Tr Space_ShowProtected}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding HiddenProtectedText}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                               Visibility="{Binding HiddenProtectedText, Converter={StaticResource S2V}}" />
                                    <TextBlock Text="{app:Tr Space_UninstallHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding TopFiles}" ItemTemplate="{StaticResource EntryTemplate}"
                                      Visibility="{Binding ShowFiles, Converter={StaticResource B2V}}" />
                        <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource EntryTemplate}"
                                      Visibility="{Binding ShowFolders, Converter={StaticResource B2V}}" />

                        <StackPanel Visibility="{Binding ShowDuplicates, Converter={StaticResource B2V}}">
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding MarkDuplicatesCommand}" Margin="0,0,8,0">
                                        <TextBlock Text="{app:Tr Space_MarkCopies}" />
                                    </Button>
                                    <Button Command="{Binding CancelDuplicatesCommand}" Visibility="{Binding IsFindingDuplicates, Converter={StaticResource B2V}}">
                                        <TextBlock Text="{app:Tr Test_Cancel}" />
                                    </Button>
                                    <Button Command="{Binding FindDuplicatesCommand}" Style="{StaticResource PrimaryButton}"
                                            Visibility="{Binding IsFindingDuplicates, Converter={StaticResource IBV}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" />
                                            <TextBlock Text="{app:Tr Space_FindDups}" Margin="9,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding DuplicateStatus}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{app:Tr Space_DupHint}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <ProgressBar Value="{Binding DuplicateProgress, Mode=OneWay}" Margin="0,0,0,10"
                                         Visibility="{Binding IsFindingDuplicates, Converter={StaticResource B2V}}" />
                            <ItemsControl ItemsSource="{Binding Duplicates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <Border Background="{DynamicResource CardRaised}" Padding="12,8">
                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource EntryTemplate}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <DockPanel Margin="0,16,0,0" IsEnabled="{Binding IsIdle}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{Binding ClearSelectionCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0">
                                    <TextBlock Text="{app:Tr Opt_Clear}" />
                                </Button>
                                <Button Command="{Binding TrashSelectedCommand}" Style="{StaticResource PrimaryButton}" Padding="22,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                                        <TextBlock Text="{app:Tr Space_TrashButton}" Margin="9,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                                <TextBlock Text="{app:Tr Space_SelectedItems}" Style="{StaticResource Body}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedSizeText}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>




