<Window x:Class="Otimizador.App.Alerts.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowActivated="False" MaxWidth="460"
        FontFamily="{StaticResource MonoFont}" FontSize="12.5" Title="Otimizador alerta">
    <!-- Aviso no canto da tela: sempre escuro, borda laranja de atenção. -->
    <Border Background="#F2000000" BorderBrush="#FB923C" BorderThickness="2" Padding="16,12" Cursor="Hand" Margin="12">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Foreground="#FB923C" FontSize="16" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Foreground="#FB923C" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="MessageText" Foreground="White" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
