<Application x:Class="Otimizador.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Otimizador.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- O primeiro dicionário é o tema ativo (trocado em tempo real pelo ThemeService). -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="B2V" />
            <conv:InverseBoolToVisibility x:Key="IBV" />
            <conv:StringToVisibility x:Key="S2V" />
            <conv:TempBrush x:Key="TempBrush" />
            <conv:NotBool x:Key="NotBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

