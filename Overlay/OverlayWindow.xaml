<Window x:Class="Otimizador.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowActivated="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource MonoFont}" FontSize="12.5" Title="Otimizador overlay">
    <!-- O overlay tem sempre fundo escuro translúcido e texto branco: lê-se bem sobre jogos e janelas claras. -->
    <Border Background="#D9000000" BorderBrush="#99FFFFFF" BorderThickness="1" Padding="12,9" Cursor="SizeAll">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale.Factor}" ScaleY="{Binding Scale.Factor}" />
        </Border.LayoutTransform>
        <StackPanel>
            <TextBlock Text="OTIMIZADOR" FontSize="9.5" Foreground="#99FFFFFF" Margin="0,0,0,4" />
            <TextBlock Text="{Binding CpuLine}" Foreground="White" Margin="0,1"
                       Visibility="{Binding ShowCpu, Converter={StaticResource B2V}}" />
            <TextBlock Text="{Binding GpuLine}" Foreground="White" Margin="0,1"
                       Visibility="{Binding ShowGpu, Converter={StaticResource B2V}}" />
            <TextBlock Text="{Binding RamLine}" Foreground="White" Margin="0,1"
                       Visibility="{Binding ShowRam, Converter={StaticResource B2V}}" />
            <TextBlock Text="{Binding DiskLine}" Foreground="White" Margin="0,1"
                       Visibility="{Binding ShowDisk, Converter={StaticResource B2V}}" />
        </StackPanel>
    </Border>
</Window>
