<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Só o build de distribuição (Release) exige administrador; o de desenvolvimento abre normalmente. -->
    <ApplicationManifest Condition="'$(Configuration)' == 'Release'">app.manifest</ApplicationManifest>
    <RootNamespace>Otimizador.App</RootNamespace>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Product>Otimizador</Product>
    <Company>Juan</Company>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\Otimizador.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- O programa pronto (Executavel\) fica na mesma pasta, mas não faz parte da compilação. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);Executavel\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Os testes (Tests\) ficam na mesma pasta, mas fora do programa. -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Otimizador.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.2.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

</Project>








