<Window x:Class="Otimizador.App.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Icon="/Assets/Otimizador.ico"
        Width="560" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow" Title="Otimizador">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="0" Background="{DynamicResource AccentSoft}">
                <TextBlock x:Name="IconText" Style="{StaticResource Icon}" Text="&#xE897;" FontSize="17"
                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleMd}" VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="MessageText" Grid.Row="1" Style="{StaticResource Body}" Margin="0,16,0,0" FontSize="13.5" />

        <Border x:Name="DetailsCard" Grid.Row="2" Style="{StaticResource CardFlat}" Margin="0,16,0,0" Padding="14,10"
                Visibility="Collapsed">
            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DetailsText" Style="{StaticResource Body}" Foreground="{DynamicResource TextPrimary}" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="104" Margin="0,0,10,0" Click="Cancel_Click" />
            <Button x:Name="OkButton" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="124" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>

